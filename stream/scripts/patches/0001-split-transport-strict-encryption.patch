+void LiGetP6aNegotiation(P6A_NEGOTIATION* info) {
+    memset(info, 0, sizeof(*info));
+    info->supported = EncryptionFeaturesSupported;
+    info->requested = EncryptionFeaturesRequested;
+    info->enabled = EncryptionFeaturesEnabled;
+    info->videoEncrypted = !!(EncryptionFeaturesEnabled & SS_ENC_VIDEO);
+    info->audioEncrypted = AudioEncryptionEnabled;
+    info->controlEncrypted = APP_VERSION_AT_LEAST(7, 1, 431);
+    info->controlV2 = !!(EncryptionFeaturesEnabled & SS_ENC_CONTROL_V2);
+    info->videoFormat = NegotiatedVideoFormat;
+}
