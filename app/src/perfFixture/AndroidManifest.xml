<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- It wipes the app's data: only adb shell (which holds DUMP) may send it, never another app. -->
        <receiver android:name="me.ayuilos.miffan.perf.PerfFixtureReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="me.ayuilos.miffan.PERF_FIXTURE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
